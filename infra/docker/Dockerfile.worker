FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=4

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --create-home app

COPY backend/pyproject.toml ./backend/pyproject.toml
COPY backend/app ./backend/app
COPY backend/alembic ./backend/alembic
COPY backend/alembic.ini ./backend/alembic.ini

RUN pip install --no-cache-dir "./backend[asr]" \
    && mkdir -p /data/audio /home/app/.cache \
    && chown -R app:app /app /data /home/app

WORKDIR /app/backend
USER app

# One job at a time: a transcription holds several GB of RAM, and prefetching
# additional work would only queue it in memory.
CMD ["celery", "-A", "app.workers.celery_app.celery_app", "worker", \
     "-Q", "asr,nlp", "--loglevel=INFO", "--concurrency=1"]
