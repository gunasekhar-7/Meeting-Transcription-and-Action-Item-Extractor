# ---------------------------------------------------------------------------
# Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

ENV=local

# --- Database --------------------------------------------------------------
# Zero-setup local default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://meeting:meeting@localhost:5432/meeting

# --- Auth ------------------------------------------------------------------
# MUST be unique and at least 32 characters in production.
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Storage ---------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/audio
# STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# --- Upload limits ---------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_AUDIO_MINUTES=180

# --- Speech recognition ----------------------------------------------------
# fake = deterministic canned transcript (tests/demos only)
# faster_whisper = real transcription; requires the [asr] extra
ASR_PROVIDER=fake
ASR_MODEL=small
ASR_COMPUTE_TYPE=int8
ASR_BEAM_SIZE=5
# large-* models are refused on CPU unless ALLOW_SLOW_CPU_MODELS=1

# --- Diarization (speaker attribution) -------------------------------------
# none = disabled
# fake = deterministic canned speaker turns (tests/demos only)
# pyannote = real speaker diarization via pyannote.audio (requires HF_TOKEN and [diarization] extra)
DIARIZATION_PROVIDER=none
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=

# --- Meeting intelligence --------------------------------------------------
# rule_based = offline deterministic fallback, no API key required
# openai_compatible = any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=rule_based
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# The GPT-4o/4.1 family retires 2027-01-14. Set a current model in your account.
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=60
LLM_INPUT_PRICE_PER_MILLION=0.10
LLM_OUTPUT_PRICE_PER_MILLION=0.50
PROMPT_VERSION=2026-11-02.1
SCHEMA_VERSION=1.0.0

# --- Jobs ------------------------------------------------------------------
# inline = FastAPI background task (single process, demo/local)
# celery = Redis-backed workers (Compose default)
JOBS_MODE=inline
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501
API_DOCS_ENABLED=true
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
AUDIO_RETENTION_DAYS=30

# --- Postgres (Compose only) ----------------------------------------------
POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting
